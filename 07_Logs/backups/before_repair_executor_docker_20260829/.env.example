# 这是环境变量参考模板；程序不会自动读取 .env 文件，请按 README 在 PowerShell 中设置变量。
# 不要提交真实密钥。
AIOPS_AUTH_ENABLED=false
AIOPS_API_KEYS={"replace-with-strong-viewer-key":"viewer","replace-with-strong-operator-key":"operator","replace-with-strong-approver-key":"approver"}
AIOPS_LLM=auto
AIOPS_DEEPSEEK_API_KEY=
AIOPS_DEEPSEEK_MODEL=deepseek-chat
AIOPS_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
AIOPS_EVENT_BUS=memory
AIOPS_TOPOLOGY=json
AIOPS_SAFETY_BACKEND=memory
AIOPS_SAFETY_REDIS_URL=redis://localhost:6379/0
AIOPS_SAFETY_KEY_PREFIX=project024:aiops:safety
AIOPS_CELERY_BROKER=redis://localhost:6379/0
