# 这是环境变量参考模板；程序不会自动读取 .env 文件，请按 README 在 PowerShell 中设置变量。
# 不要提交真实密钥。
AIOPS_LLM=none
AIOPS_DEEPSEEK_API_KEY=
AIOPS_DEEPSEEK_MODEL=deepseek-chat
AIOPS_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
AIOPS_EVENT_BUS=memory
AIOPS_TOPOLOGY=json
AIOPS_CELERY_BROKER=redis://localhost:6379/0
